# Copy this file to .env.local (or set these in the Vercel project settings) and
# fill in the real values. Never commit real keys: this repository is public.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon public key>

# Server-only administrator key. Bypasses row level security: keep it out of git.
SUPABASE_SERVICE_ROLE_KEY=<service_role key>

# Shared secret that guards /api/revalidate and /api/posts/create.
# Generate one: python3 -c "import secrets; print(secrets.token_hex(32))"
REVALIDATE_SECRET=<random 64 hex characters>

# Coupang Partners tracking id
NEXT_PUBLIC_COUPANG_AF_ID=AF0000000

# Canonical site origin (canonical, hreflang, sitemap, og:url)
NEXT_PUBLIC_SITE_URL=https://www.example.com
